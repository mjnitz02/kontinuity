# Copy to Makefile.local (gitignored) and fill in for this machine.
#
# Find your iPad's identifier with:
#   xcrun devicectl list devices
DEVICE_ID = 00000000-0000000000000000

# Optional: override the simulator used by `make build` / `make test-unit`.
# SIMULATOR_NAME = iPad Pro 11-inch (M5)

# App Store Connect API key for `make testflight`. Issue one under
# App Store Connect > Users and Access > Integrations > App Store Connect API
# (App Manager role), then drop the .p8 at
# ~/.appstoreconnect/private_keys/AuthKey_<KEY_ID>.p8 — it downloads once and
# cannot be re-fetched. The issuer ID is at the top of that same page.
# ASC_KEY_ID    = XXXXXXXXXX
# ASC_ISSUER_ID = 00000000-0000-0000-0000-000000000000

# Optional: a local Komga instance to develop against — see the komga-docker
# setup for a disposable one. Credentials belong here, not in the Makefile,
# because this file is gitignored and that one isn't.
#
#   make komga-up / komga-check / komga-address / komga-stop
# KOMGA_DIR      = $(HOME)/workspaces/komga-docker
# KOMGA_URL      = http://localhost:25600
# KOMGA_EMAIL    = you@example.com
# KOMGA_PASSWORD = your-password
# KOMGA_API_KEY  = your-api-key
